# =================================================================
# PISTA Environment Configuration Template
# Copy this file to .env before running `docker compose up --build`
# =================================================================

# 1. PostgreSQL Database Configuration
POSTGRES_DB=pista_db
POSTGRES_USER=pista_user
POSTGRES_PASSWORD=pista_secure_password

# 2. Razorpay Credentials (Optional for local simulated transactions)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# 3. Frontend & API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
