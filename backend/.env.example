# RiskGuard Production Environment Configuration Template (NO SECRETS)
# Copy this file to .env and provide your actual credentials.

# 1. API Configuration
PROJECT_NAME="RiskGuard Production Fraud Decision API"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# 2. Database Configuration
# For PostgreSQL (Production / Docker):
DATABASE_URL=postgresql://riskguard_user:riskguard_secure_password@postgres:5432/riskguard_db
# For SQLite (Local standalone fallback):
# DATABASE_URL=sqlite:///./riskguard_production.db

# 3. Razorpay Test Mode Credentials
# Acquire from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 4. Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
